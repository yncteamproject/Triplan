# 배포 서버(EC2)에서 백엔드를 띄우는 서비스 설정 (블루-그린, docs/deploy.md)
# /etc/systemd/system/triplan@.service에 복사해서 쓴다. @ 뒤의 값이 칸(포트) 번호다
#   systemctl start triplan@8081   → /opt/triplan/slots/8081/triplan.jar를 8081 포트로 실행
#   systemctl start triplan@8082   → /opt/triplan/slots/8082/triplan.jar를 8082 포트로 실행
# 평소에는 한 칸만 켜 두고, 배포할 때 쉬는 칸에 새 버전을 띄운 뒤 Nginx를 넘긴다 (deploy/blue-green.sh)
[Unit]
Description=Triplan backend (port %i)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
# 비밀 값 파일(application-secret.yaml)은 두 칸이 같이 쓴다. 이 폴더 기준으로 읽는다
WorkingDirectory=/opt/triplan
# JVM 옵션을 서버에서 바꿀 수 있게 따로 둔다 (없으면 아래 기본값). 예: JAVA_OPTS=-Xms128m -Xmx384m
Environment="JAVA_OPTS=-Xms128m -Xmx512m"
EnvironmentFile=-/opt/triplan/jvm.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/triplan/slots/%i/triplan.jar --spring.profiles.active=prod --server.port=%i'
Restart=on-failure
RestartSec=5
# 처리 중인 요청을 마칠 시간(앱 20초)보다 조금 더 기다린 뒤 강제로 끈다
TimeoutStopSec=30
# 종료 신호를 받은 Spring은 143으로 끝난다. 실패로 보지 않는다
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
